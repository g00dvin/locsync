<!-- First-run setup: a checklist of what the app needs, each step opening the right system screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setupIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/ls_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/setupSteps"
            style="@style/LsGroupCard" />

        <TextView
            android:id="@+id/btnSetupDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_outline_accent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:text="@string/setup_done"
            android:textColor="@color/ls_accent"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
