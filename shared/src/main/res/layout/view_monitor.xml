<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 0. Real-time monitoring toggle (off by default) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_monitoring"
                android:textColor="@color/ls_text"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/monitorLiveSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:showText="false"
                xmlns:tools="http://schemas.android.com/tools"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <!-- 1. Location information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:text="@string/section_location"
                android:textAllCaps="true"
                android:textColor="@color/ls_accent_300"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/monLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/value_none"
                android:textColor="@color/ls_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/monAltAcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout style="@style/LsKvRow">
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvProvider"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvSatellites"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp" />
                </LinearLayout>

                <LinearLayout style="@style/LsKvRow">
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvSpeed"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvBearing"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp" />
                </LinearLayout>

                <LinearLayout style="@style/LsKvRow">
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvAge"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include layout="@layout/ls_kv_cell" android:id="@+id/kvFixes"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="16dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 1b. Smoothing filter state (client only; shown once the service reports it) -->
        <LinearLayout
            android:id="@+id/monFilterCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:text="@string/section_filter"
                android:textAllCaps="true"
                android:textColor="@color/ls_accent_300"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/monFilterRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 2. Link health -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.10"
            android:text="@string/link_health_title"
            android:textAllCaps="true"
            android:textColor="@color/ls_text_dim"
            android:textSize="10sp" />

        <LinearLayout style="@style/LsMetricRow">
            <include layout="@layout/ls_metric_card" android:id="@+id/lhPackets"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/ls_metric_card" android:id="@+id/lhBytes"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout style="@style/LsMetricRow">
            <include layout="@layout/ls_metric_card" android:id="@+id/lhMaxGap"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/ls_metric_card" android:id="@+id/lhAgeMean"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout style="@style/LsMetricRow">
            <include layout="@layout/ls_metric_card" android:id="@+id/lhAgeP95"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/ls_metric_card" android:id="@+id/lhCpu"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <!-- 3. Sparklines -->
        <include layout="@layout/ls_spark_card" android:id="@+id/sparkAge"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <include layout="@layout/ls_spark_card" android:id="@+id/sparkPkt"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <include layout="@layout/ls_spark_card" android:id="@+id/sparkSat"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <!-- 4. Log console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.10"
                    android:text="@string/log_title"
                    android:textAllCaps="true"
                    android:textColor="@color/ls_text_dim"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/logDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/dot_accent" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/logClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/log_clear"
                    android:textColor="@color/ls_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_console"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.45"
                android:maxHeight="190dp"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:textColor="@color/ls_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 5. Export row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnExportLogs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_outline_accent"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="9dp"
                android:text="@string/export_logs_short"
                android:textColor="@color/ls_accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnExportCsv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_outline_neutral"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="9dp"
                android:text="@string/export_csv_short"
                android:textColor="@color/ls_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
