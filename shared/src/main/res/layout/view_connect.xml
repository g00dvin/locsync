<!-- Server home ("Cluster"): status strip, satellites in use as the hero readout with the
     per-satellite signal bars, sent rate and uptime, then Pair and Start/Stop. The client app
     overrides this file with its own view_connect. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Warning banner (gone unless there is something to warn about) -->
    <LinearLayout
        android:id="@+id/connectBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_fill"
            android:tint="@color/ls_warn" />

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:textColor="@color/ls_text"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/bannerDismiss"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_dismiss"
            android:padding="12dp"
            android:src="@drawable/ic_x"
            android:tint="@color/ls_text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/dot_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/statusSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hero: satellites in use (reuses ls_stat_card's child ids), then the signal bars -->
    <LinearLayout
        android:id="@+id/statCard1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="10dp"
        android:minHeight="96dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/ls_text_dim"
            android:textSize="11sp" />

            <TextView
                android:id="@+id/signalDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ls_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Auto-sized to the free height on Android 8+; 96sp below that. -->
        <TextView
            android:id="@+id/statValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="200sp"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textColor="@color/ls_text_dim"
            android:textSize="96sp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:targetApi="o" />

        <TextView
            android:id="@+id/statUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <goodvin.locsync.shared.SatelliteBarsView
        android:id="@+id/satBars"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="6dp"
        android:text="@string/signal_caption"
        android:textColor="@color/ls_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/ls_stat_card" android:id="@+id/statCard2"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="4dp" />

        <include layout="@layout/ls_stat_card" android:id="@+id/statCard3"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPair"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_btn_outline"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/pair_button"
            android:textColor="@color/ls_text"
            android:textSize="15sp" />

        <!-- Centered icon + label: the inner TextView is not clickable, the frame is the button. -->
        <FrameLayout
            android:id="@+id/btnPower"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_btn_primary"
            android:contentDescription="@string/cd_power"
            android:focusable="true">

            <TextView
                android:id="@+id/btnPowerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_power"
                android:drawableTint="@color/ls_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/power_start"
                android:textColor="@color/ls_bg"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />
</LinearLayout>
