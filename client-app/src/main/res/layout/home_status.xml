<!-- Top of the home screen in every layout: the warning banner and the status strip with Start/Stop. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Warning banner (gone unless there is something to warn about) -->
    <LinearLayout
        android:id="@+id/connectBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_fill"
            android:tint="@color/ls_warn" />

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="10dp"
            android:textColor="@color/ls_text"
            android:textSize="12.5sp" />

        <ImageView
            android:id="@+id/bannerDismiss"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_dismiss"
            android:padding="12dp"
            android:src="@drawable/ic_x"
            android:tint="@color/ls_text_muted" />
    </LinearLayout>

    <!-- "Is the navigator getting a position?" — the one thing the driver needs to know -->
    <LinearLayout
        android:id="@+id/navCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingVertical="10dp">

        <View
            android:id="@+id/navDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/dot_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/navDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ls_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPower"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_outline"
            android:contentDescription="@string/cd_power"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_power"
            android:drawableTint="@color/ls_text"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/power_stop"
            android:textColor="@color/ls_text"
            android:textSize="14sp" />
    </LinearLayout>
</merge>
