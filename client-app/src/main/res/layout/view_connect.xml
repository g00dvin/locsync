<!-- Client override of the shared view_connect (same name → replaces it in the client app only).
     "Cluster" home, tall window: status strip, speed and heading filling the free height, then two
     rows of tiles. layout-land holds the wide, short variant (split screen). Scrolls only when the
     window is too short for the minimum sizes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/home_status" />

        <include layout="@layout/home_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="22dp"
            android:layout_marginVertical="10dp" />

        <!-- What the phone reports about the fix -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include layout="@layout/tile_stat" android:id="@+id/tileAccuracy"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp" />

            <include layout="@layout/tile_stat" android:id="@+id/tileSats"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp" />

            <include layout="@layout/tile_stat" android:id="@+id/tileFresh"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>

        <!-- The phone's battery and heat, and the car's fuel and odometer. Each tile shows only when
             there is data for it; the row goes away when none has. -->
        <LinearLayout
            android:id="@+id/rowDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <include layout="@layout/tile_stat" android:id="@+id/tilePhone"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:visibility="gone" />

            <include layout="@layout/tile_stat" android:id="@+id/tileFuel"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:visibility="gone" />

            <include layout="@layout/tile_stat" android:id="@+id/tileOdo"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />
    </LinearLayout>
</ScrollView>
