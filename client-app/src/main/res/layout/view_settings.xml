<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Permissions -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_permissions" />
        <LinearLayout style="@style/LsGroupCard">
            <include layout="@layout/row_setting_action" android:id="@+id/rowPermissions" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowSetup" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowPair" />
        </LinearLayout>

        <!-- Display -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_display" />
        <LinearLayout style="@style/LsGroupCard">
            <include layout="@layout/row_setting_action" android:id="@+id/rowUiScale" />
        </LinearLayout>

        <!-- Automation -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_automation" />
        <LinearLayout style="@style/LsGroupCard">
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowAutostartWifi" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowAutostartBoot" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowA11yAutostart" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowStaticJitter" />
        </LinearLayout>

        <!-- Smoothing (Kalman filter feeding the mock provider) -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_smoothing" />
        <LinearLayout style="@style/LsGroupCard">
            <!-- Style preset: label + sub (row_setting_action ids) over a three-way selector -->
            <LinearLayout
                android:id="@+id/rowFilterPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="11dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/row_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_preset"
                    android:textColor="@color/ls_text"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/row_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ls_text_dim"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_console"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView android:id="@+id/presetSmooth" style="@style/LsSegment"
                        android:text="@string/filter_preset_smooth" />
                    <TextView android:id="@+id/presetBalanced" style="@style/LsSegment"
                        android:text="@string/filter_preset_balanced_short" />
                    <TextView android:id="@+id/presetResponsive" style="@style/LsSegment"
                        android:text="@string/filter_preset_responsive" />
                </LinearLayout>
            </LinearLayout>
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowFilterAdvanced" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowFilterReset" />
        </LinearLayout>

        <!-- Advanced smoothing parameters, collapsed by default -->
        <LinearLayout style="@style/LsGroupCard"
            android:id="@+id/cardFilterAdvanced"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowReportUncertainty" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowLatencyComp" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowExtraLatency" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowNetworkDelay" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowWifiLowLatency" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowTurnModel" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowTurnResponsiveness" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowBearingComp" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowMinBearingAcc" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowAdaptivePosition" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowGating" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowGateThreshold" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowStandstillHold" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowStandstillSpeed" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowAdaptiveNoise" />
            <include layout="@layout/row_setting_input" android:id="@+id/rowProcessNoise" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowCarSpeed" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowCarMotion" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowSpeedRamp" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowOutput1Hz" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowSendSpeed" />
        </LinearLayout>

        <!-- Diagnostics -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_diagnostics" />
        <LinearLayout style="@style/LsGroupCard">
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowDebug" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowMetrics" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_toggle" android:id="@+id/rowTrackRecording" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowExportAll" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowClearLogs" />
        </LinearLayout>

        <!-- About -->
        <TextView style="@style/LsGroupLabel" android:text="@string/group_about" />
        <LinearLayout style="@style/LsGroupCard">
            <include layout="@layout/row_setting_action" android:id="@+id/rowVersion" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowUpdate" />
            <View style="@style/LsDivider" />
            <include layout="@layout/row_setting_action" android:id="@+id/rowLicense" />
        </LinearLayout>

        <!-- Footer -->
        <!-- Link to the project page -->
        <TextView
            android:id="@+id/repoLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="web"
            android:gravity="center"
            android:linksClickable="true"
            android:minHeight="44dp"
            android:text="@string/repo_link"
            android:textColor="@color/ls_text_dim"
            android:textColorLink="@color/ls_accent_400"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
