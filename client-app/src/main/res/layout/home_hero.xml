<!-- Home hero: speed auto-sized to the free space, heading beside it. Both reuse tile_stat's child
     ids (the heading lives in its own file so the ids stay unique per layout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:minHeight="120dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tileSpeed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/ls_text_dim"
        android:textSize="11sp" />

        <!-- Auto-sized to the free height: 200sp on a roomy head unit, smaller where it's tight. -->
        <TextView
            android:id="@+id/tileValue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="260sp"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textColor="@color/ls_text_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tileUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ls_text_muted"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tileHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ls_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="16dp"
        android:background="@color/ls_hairline" />

    <include layout="@layout/tile_heading" android:id="@+id/tileHeading"
        android:layout_width="wrap_content" android:layout_height="match_parent" />
</LinearLayout>
