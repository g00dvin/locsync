<!-- Compact main-screen tile for the wide, short window: smaller type, label and value on one row each. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="11dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.08"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="@color/ls_text_dim"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tileValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/value_none"
            android:textColor="@color/ls_text_dim"
            android:maxLines="1"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tileUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:textColor="@color/ls_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ls_text_muted"
        android:textSize="11sp" />
</LinearLayout>
