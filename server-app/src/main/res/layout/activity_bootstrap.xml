<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bootstrap_title"
            android:textColor="@color/ls_text"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/bootstrapProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_intro"
        android:textColor="@color/ls_text_dim"
        android:textSize="12.5sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_addr_label"
        android:textColor="@color/ls_text"
        android:textSize="12.5sp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/bootstrapAddr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/bootstrap_addr_hint"
            android:textColor="@color/ls_text"
            android:textColorHint="@color/ls_text_dim"
            android:textSize="13sp"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <Button
            android:id="@+id/bootstrapScan"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bootstrap_scan"
            android:textColor="@color/ls_accent"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Live step status: connection, ADB, install -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ls_surface"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout style="@style/BootstrapStepRow">
            <TextView android:id="@+id/stepConnIcon" style="@style/BootstrapStepIcon" />
            <LinearLayout style="@style/BootstrapStepText">
                <TextView style="@style/BootstrapStepLabel" android:text="@string/bootstrap_step_conn" />
                <TextView android:id="@+id/stepConnDetail" style="@style/BootstrapStepDetail" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/BootstrapStepRow">
            <TextView android:id="@+id/stepAdbIcon" style="@style/BootstrapStepIcon" />
            <LinearLayout style="@style/BootstrapStepText">
                <TextView style="@style/BootstrapStepLabel" android:text="@string/bootstrap_step_adb" />
                <TextView android:id="@+id/stepAdbDetail" style="@style/BootstrapStepDetail" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/BootstrapStepRow">
            <TextView android:id="@+id/stepInstallIcon" style="@style/BootstrapStepIcon" />
            <LinearLayout style="@style/BootstrapStepText">
                <TextView style="@style/BootstrapStepLabel" android:text="@string/bootstrap_step_install" />
                <TextView android:id="@+id/stepInstallDetail" style="@style/BootstrapStepDetail" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/bootstrapTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_test"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/bootstrapEnableAdb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_enable_adb"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_grants_label"
        android:textColor="@color/ls_text_dim"
        android:textSize="11.5sp"
        android:layout_marginBottom="2dp" />

    <CheckBox
        android:id="@+id/grantMockLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/bootstrap_grant_mock"
        android:textColor="@color/ls_text"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/grantInstall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_grant_install"
        android:textColor="@color/ls_text"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/grantVpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_grant_vpn"
        android:textColor="@color/ls_text"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/grantWriteSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_grant_settings"
        android:textColor="@color/ls_text"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/bootstrapInstallClient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_install_client"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/bootstrapInstallApk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootstrap_install_apk"
        android:textAllCaps="false"
        android:layout_marginBottom="14dp" />

    <ScrollView
        android:id="@+id/bootstrapLogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ls_surface_sunken">

        <TextView
            android:id="@+id/bootstrapLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@color/ls_text_dim"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
