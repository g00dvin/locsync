    <string name="setup_background_sub">Чтобы сервер работал с выключенным экраном и в другом приложении</string>
    <string name="setup_battery">Без ограничений батареи</string>
    <string name="setup_battery_sub">Чтобы Android не останавливал сервер в поездке</string>
    <string name="setup_notifications">Уведомления</string>
